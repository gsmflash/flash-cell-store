# =============================================================
# Flash Cell Store — Frontend Environment Variables
# =============================================================
# Vite expõe apenas variáveis com prefixo VITE_ ao browser.
# NUNCA coloque secrets aqui — são visíveis no bundle de produção.
# =============================================================

# URL da API backend
# Em desenvolvimento: deixe vazio (o proxy do Vite redireciona /api automaticamente)
# Em produção (Cloudflare Pages): preencha com a URL do seu backend
# Exemplo: VITE_API_URL=https://api.flashcellstore.com
VITE_API_URL=
