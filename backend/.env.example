# =============================================================
# Flash Cell Store — Backend Environment Variables
# =============================================================
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA comite o arquivo .env.
# =============================================================

# Ambiente
NODE_ENV=development

# Servidor
PORT=3001

# Banco de dados PostgreSQL
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flash_cell_store

# CORS — URL do frontend em desenvolvimento
CORS_ORIGIN=http://localhost:5173

# =============================================================
# Cloudflare R2 (configurar quando necessário)
# =============================================================
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=flash-cell-store
# R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
