# =============================================================
# Flash Cell Store — Backend Environment Variables
# =============================================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA comite o arquivo .env.
# =============================================================

# Ambiente
NODE_ENV=development

# Servidor
PORT=3001

# Banco de dados PostgreSQL
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flash_cell_store

# CORS — URL do frontend em desenvolvimento
CORS_ORIGIN=http://localhost:5173

# =============================================================
# Pagamentos — Mercado Pago
# =============================================================
# URL pública do frontend (usada nos links de retorno do checkout)
FRONTEND_URL=http://localhost:5173
# Credencial de TESTE do Mercado Pago — nunca use a de produção em dev.
# Obtenha em: https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# =============================================================
# E-mail transacional — Resend
# =============================================================
# Obtenha em: https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=Flash Cell Store <naoresponda@flashcell.com.br>

# =============================================================
# JWT — Autenticação
# =============================================================
# IMPORTANTE: use DOIS segredos DIFERENTES — um para access token, outro
# para refresh token. Nunca reutilize o mesmo valor entre os dois: assim,
# o vazamento de um não compromete o outro.
# Gere cada um com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=gere-um-valor-unico-com-no-minimo-32-caracteres
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=gere-outro-valor-diferente-com-no-minimo-32-caracteres
JWT_REFRESH_EXPIRES_IN=30d

# =============================================================
# Cloudflare R2 (configurar quando necessário)
# =============================================================
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=flash-cell-store
# R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
